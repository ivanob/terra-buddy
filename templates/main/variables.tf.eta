variable "region" {
  description = "The AWS region to deploy in"
}

# Pay attention to your `echo $AWS_PROFILE` variable in your machine.
# to remove it use `unset AWS_PROFILE`
variable "account_id" {
  description = "The AWS account ID"
}

variable "aws_profile" { # This profile is defined in the ~/.aws/credentials file
  description = "The AWS profile to use for the deployment"
}